# AI Judge 워커 — 선택적 오버라이드.
# 이 파일을 worker/.env 로 복사해서 쓴다. (worker/.env 는 .gitignore 처리됨)
#
# 아래 값들은 저장소 루트 .env.local 에서 자동으로 읽어오므로
# 다르게 쓰고 싶을 때만 여기에 적으면 된다.
#
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_POOLER_HOST=aws-0-ap-northeast-1.pooler.supabase.com

# 코멘트 생성 (사이클 1 후반부터 필요)
ANTHROPIC_API_KEY=

# 완료 이메일 알림 (사이클 3)
RESEND_API_KEY=

# 워커 운영
AI_JUDGE_WORKER_ID=worker-local
AI_JUDGE_POLL_SECONDS=10
AI_JUDGE_STALE_MINUTES=30
